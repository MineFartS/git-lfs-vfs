[submodule ".jdk17"]
	path = .jdk17
	url = https://github.com/MineFartsEmbed/JDK
	branch = 17
    ignore = dirty
[submodule ".maven"]
	path = .maven
	url = https://github.com/MineFartsEmbed/Maven
	branch = 3.10.1
    ignore = dirty
[submodule ".winfsp"]
	path = .winfsp
	url = https://github.com/MineFartsEmbed/WinFsp
    ignore = dirty
